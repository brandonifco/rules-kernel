<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test-support code shared across this repository's test projects, and published so
       engines built on the kernel can use the same scripted source in their own tests.
       It is not a test project: it carries no test framework and runs no tests. -->
  <!-- Multi-targeted so an engine does not have to upgrade its framework before it can
       adopt the kernel. That is not hypothetical: SRD_Combat is net8.0 with rollForward
       disabled, and a net10.0-only package locked it out of even the dependency-free base
       assembly. A kernel whose whole purpose is being referenced by engines that outlive
       it cannot make the framework the price of entry. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TargetFramework />
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>RulesKernel.Testing</RootNamespace>
    <PackageId>RulesKernel.Testing</PackageId>
    <Description>Test doubles for deterministic engines: a scripted IRandomSource that fails loudly on exhaustion.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RulesKernel.Randomness/RulesKernel.Randomness.csproj" />
  </ItemGroup>

  <!-- Lives under tests/ but IS published (PackageId above) and referenced, not copied: a
       shape change here breaks every engine's test suite without a recompile telling them so.
       PublicApiAnalyzers turns an undeclared change to this surface into a build error against
       PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt, so it can only pass alongside a deliberate
       decision record per CLAUDE.md principle 5. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
