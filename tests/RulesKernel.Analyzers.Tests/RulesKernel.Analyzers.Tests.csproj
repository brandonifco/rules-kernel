<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RulesKernel.Analyzers.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test names are the documentation here; the repo-wide docs requirement applies to
         the packaged assemblies, not to test projects that ship to nobody. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!-- A plain reference, not OutputItemType="Analyzer": these tests drive the analyzer as a
       library against compilations they construct, rather than having it applied to
       themselves. Applying it here would make the fixtures below fail their own build. -->
  <ItemGroup>
    <ProjectReference Include="../../src/RulesKernel.Analyzers/RulesKernel.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
