<Project>

  <!-- Repo-wide defaults. This is a deterministic rules kernel consumed as a versioned
       package by engines that outlive it: reproducibility and zero-warning builds are
       load-bearing, not stylistic. See docs/architecture.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn />
    <!-- Each project restores from its own committed packages.lock.json rather than
         letting NuGet re-resolve transitive versions on every restore. A kernel whose
         central claim is reproducibility cannot have a build that quietly resolves
         differently from one machine to the next. Regenerate deliberately; the exact
         command is in scripts/validate.sh's restore step. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Packaging defaults. The kernel is REFERENCED, never copied: a fix here reaches
       every engine built on it through a version bump. That is the whole reason this
       repository is separate from any engine. See docs/decisions/0001. -->
  <PropertyGroup>
    <Authors>Brandon</Authors>
    <Product>Rules Kernel</Product>
    <RepositoryUrl>https://github.com/brandonifco/rules-kernel</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!-- main is never a release version. VersionPrefix names the NEXT release; the
         suffix is what says this tree is not it, so an ordinary `dotnet pack` here
         produces 0.3.0-dev, which nuget.org has never served and never will.

         This exists because the alternative was tried. main carried VersionPrefix 0.2.0
         for the entire life of the 0.2.0 release, so every default pack on main produced
         bytes labelled as a version already on nuget.org, and restoring one of those
         packs writes a cache entry under the published version that every later restore
         on the machine then serves instead of the real package. That happened, silently,
         for hours (scripts/pack-local.sh tells the story). pack-local.sh stays as defence
         in depth, but it is opt-in, and a footgun whose safety catch is a different
         command is still a footgun: the DEFAULT command has to be the safe one.

         The release PR clears VersionSuffix, promotes the public API baselines, and is
         tagged; main then moves to the next prefix with the suffix restored. The cycle is
         written out in CLAUDE.md, and publish.yml enforces the half a reviewer cannot:
         it compares the tag to the RESOLVED version, so a tree that still carries a
         suffix cannot be tagged as a release. See
         docs/decisions/0012-a-development-tree-is-not-a-release-candidate.md. -->
    <VersionPrefix>0.3.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageProjectUrl>https://github.com/brandonifco/rules-kernel</PackageProjectUrl>
    <PackageTags>rules-engine;determinism;replay;provenance</PackageTags>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
