<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately references RulesKernel and NOTHING else. That absence is the point:
       an engine over a regulation draws no random values, and ArchitectureTests asserts
       this assembly never acquires a dependency on RulesKernel.Randomness. See
       docs/decisions/0002. -->
  <PropertyGroup>
    <RootNamespace>RegulatoryProbe</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RulesKernel/RulesKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
