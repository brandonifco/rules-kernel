<Project Sdk="Microsoft.NET.Sdk">

  <!-- The ruleset-agnostic floor. RulesKernel must not reference any other assembly in
       this repository, and must not touch the filesystem, a clock, the network, the
       environment, or randomness. Enforced by the layering and core-boundary checks in
       tools/repo-checks.py, and by ArchitectureTests. See docs/decisions/0001. -->
  <PropertyGroup>
    <RootNamespace>RulesKernel</RootNamespace>
    <PackageId>RulesKernel</PackageId>
    <Description>Ruleset-agnostic determinism primitives: replay identity, provenance, and the unresolved-result contract.</Description>
  </PropertyGroup>

  <!-- This assembly ships to nuget.org and is referenced, not copied (see Directory.Build.props):
       a shape change here breaks every engine built on it without a recompile telling them so.
       PublicApiAnalyzers turns an undeclared change to this surface into a build error against
       PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt, so it can only pass alongside a deliberate
       decision record per CLAUDE.md principle 5. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
