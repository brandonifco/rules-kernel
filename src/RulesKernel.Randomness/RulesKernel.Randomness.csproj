<Project Sdk="Microsoft.NET.Sdk">

  <!-- Optional by design. An engine over a corpus that resolves no random outcome, such
       as a statute, a regulation, or a deterministic board game, references RulesKernel
       and never this package. See docs/decisions/0002. -->
  <!-- Multi-targeted so an engine does not have to upgrade its framework before it can
       adopt the kernel. That is not hypothetical: SRD_Combat is net8.0 with rollForward
       disabled, and a net10.0-only package locked it out of even the dependency-free base
       assembly. A kernel whose whole purpose is being referenced by engines that outlive
       it cannot make the framework the price of entry. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TargetFramework />
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>RulesKernel.Randomness</RootNamespace>
    <PackageId>RulesKernel.Randomness</PackageId>
    <Description>Replay-stable pseudorandomness: PCG32 and bias-free bounded draws.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RulesKernel/RulesKernel.csproj" />
  </ItemGroup>

  <!-- This assembly ships to nuget.org and is referenced, not copied (see Directory.Build.props):
       a shape change here breaks every engine built on it without a recompile telling them so.
       PublicApiAnalyzers turns an undeclared change to this surface into a build error against
       PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt, so it can only pass alongside a deliberate
       decision record per CLAUDE.md principle 5. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
